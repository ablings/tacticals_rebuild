diff --git a/ui/art/icons/_export_icons.py b/ui/art/icons/_export_icons.py
new file mode 100644
index 0000000000000000000000000000000000000000..1aa70a066b2d770f0c70e0cd3e16d27299f190ee
--- /dev/null
+++ b/ui/art/icons/_export_icons.py
@@ -0,0 +1,40 @@
+from pathlib import Path
+from PIL import Image, ImageDraw, ImageFont
+import json
+
+root = Path(__file__).parent
+out = root / '_upload'
+out.mkdir(exist_ok=True)
+manifest = json.loads((root / '_icon_sources.json').read_text())
+for item in manifest:
+    name = item['name']
+    im = Image.open(item['path']).convert('RGBA')
+    size = (256, 96) if name == 'icon_live' else ((64,64) if name == 'icon_eye' else (128,128))
+    im = im.resize(size, Image.Resampling.LANCZOS)
+    im.save(out / (name + '.png'))
+
+bg = '#16171B'
+preview = Image.new('RGB', (1040, 1000), bg)
+d = ImageDraw.Draw(preview)
+font = ImageFont.truetype('C:/Windows/Fonts/arial.ttf', 16)
+d.text((24,16), 'TACTICALS  /  128 px + 32 px', font=font, fill='#F2EDE0')
+for i,item in enumerate(manifest):
+    name=item['name']
+    im=Image.open(out / (name+'.png'))
+    x=20+(i%4)*260
+    y=60+(i//4)*230
+    d.text((x,y),name+'.png',font=font,fill='#F2EDE0')
+    for edge,dx in [(128,0),(32,166)]:
+        thumb=im.copy()
+        thumb.thumbnail((edge,edge),Image.Resampling.LANCZOS)
+        if name=='icon_eye': thumb=im.resize((edge,edge),Image.Resampling.LANCZOS)
+        preview.paste(thumb,(x+dx+(edge-thumb.width)//2,y+34+(128-thumb.height)//2),thumb)
+        d.text((x+dx,y+176),str(edge)+' px',font=font,fill='#95969A')
+preview.save(root/'_upload_preview.png')
+for item in manifest:
+    p=out/(item['name']+'.png')
+    im=Image.open(p)
+    a=im.getchannel('A')
+    assert a.getextrema()==(0,255) or a.getextrema()[0]==0
+    assert a.getpixel((0,0))==0
+    print(p.name,im.size,im.mode,'alpha',a.getextrema())
