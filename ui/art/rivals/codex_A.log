index 0000000000000000000000000000000000000000..b159242da8ec65721ccf3b8442305c2e30bb9a96
--- /dev/null
+++ b/ui/art/rivals/_upload/prepare_A.py
@@ -0,0 +1,31 @@
+import json
+from pathlib import Path
+from PIL import Image, ImageDraw, ImageFont
+
+root = Path(__file__).resolve().parent
+items = json.loads((root / 'manifest_A.json').read_text())
+for item in items:
+    im = Image.open(item['path']).convert('RGBA').resize((512, 512), Image.Resampling.LANCZOS)
+    if item['tint']:
+        alpha = im.getchannel('A')
+        im = Image.new('RGBA', im.size, (255, 255, 255, 0))
+        im.putalpha(alpha)
+    im.save(root / (item['name'] + '.png'))
+    assert im.getchannel('A').getextrema() == (0, 255)
+
+sheet = Image.new('RGB', (1000, 1040), '#16171B')
+draw = ImageDraw.Draw(sheet)
+font = ImageFont.truetype('C:/Windows/Fonts/consola.ttf', 15)
+small = ImageFont.truetype('C:/Windows/Fonts/consola.ttf', 12)
+for i, item in enumerate(items):
+    x, y = (i % 4) * 250, (i // 4) * 260
+    draw.rectangle((x, y, x+249, y+259), outline='#34353A')
+    im = Image.open(root / (item['name'] + '.png'))
+    for size, dx, dy in [(128, 61, 25), (32, 109, 180)]:
+        preview = im.resize((size, size), Image.Resampling.LANCZOS)
+        sheet.paste(preview, (x+dx, y+dy), preview)
+    draw.text((x+10, y+230), item['name']+'.png', font=font, fill='#FFFFFF')
+    draw.text((x+10, y+8), '128 px', font=small, fill='#A0A0A4')
+    draw.text((x+10, y+185), '32 px', font=small, fill='#A0A0A4')
+sheet.save(root.parent / '_contact_A.png')
+print('\n'.join(item['name'] + '.png' for item in items))

